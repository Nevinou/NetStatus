<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/status_maintenance_bg"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginTop="4dp">

        <!-- En-tête : Titre + Badge Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/maintenanceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mise à jour infrastructure"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/status_maintenance"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/maintenanceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="À venir"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"
                android:background="@drawable/badge_background"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Section Horaires : Début et Fin côte à côte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <!-- Bloc Début -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/time_item_background"
                android:padding="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DÉBUT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/heure_debut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:00"
                    android:textSize="16sp"
                    android:textColor="@color/status_maintenance"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/date_debut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29 Jan 2026"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Bloc Fin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/time_item_background"
                android:padding="12dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIN PRÉVUE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/heure_fin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="06:00"
                    android:textColor="@color/status_maintenance"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date_fin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29 Jan 2026"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Section Impact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <View
                android:id="@+id/impactIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/status_inconnu"/>

            <TextView
                android:id="@+id/impact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statut Inconnu"
                android:textSize="16sp"
                android:textColor="@color/status_inconnu"
                android:textStyle="bold"
                android:layout_marginStart="12dp"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>